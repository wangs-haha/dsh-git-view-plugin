{
  "name": "@local/dsh-git-view",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.28.5",
  "engines": {
    "node": ">=22"
  },
  "description": "IntelliJ-style Git panel: workspace file tree, commit graph, per-branch actions, fetch/pull/push with live progress, rollback, AI-drafted commit messages, and history operations.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wangs-haha/dsh-git-view-plugin.git"
  },
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "scripts": {
    "check": "node scripts/check-project.mjs",
    "test:tooling": "node --test scripts/project.test.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "build": "node scripts/build.mjs",
    "reload": "node scripts/reload.mjs --wait",
    "smoke": "node scripts/smoke-host.mjs && node scripts/smoke-client.mjs && node scripts/smoke-panes.mjs && node scripts/smoke-diff.mjs && node scripts/smoke-selfcheck.mjs",
    "audit": "node scripts/audit.mjs",
    "preview": "node scripts/preview.mjs",
    "shots": "node scripts/readme-shots.mjs",
    "verify": "pnpm run check && pnpm run test:tooling && pnpm run typecheck && pnpm run build && pnpm run smoke"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
